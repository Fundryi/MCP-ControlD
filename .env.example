# Copy to .env (gitignored) and fill in. Never commit the real values.
# Create tokens in the Control D dashboard.

# Required. A read-scoped token. Every GET uses this one.
CONTROLD_API_TOKEN_READ=YOUR_API_TOKEN

# Optional. A write-scoped token. With no write credential configured the
# server cannot write: the write tools are never registered.
# CONTROLD_API_TOKEN_WRITE=YOUR_API_TOKEN

# Optional. Sent as X-Force-Org-Id on every request. Organization accounts only.
# CONTROLD_ORG_ID=1234567890

# Optional. Defaults to https://api.controld.com. Must be https, unless it
# points at a loopback host for testing.
# CONTROLD_API_BASE_URL=https://api.controld.com

# Deprecated, still supported. One token for both roles. On its own it grants
# reads only; add CONTROLD_ENABLE_WRITES=1 to also allow writes.
# CONTROLD_API_TOKEN=YOUR_API_TOKEN
# CONTROLD_ENABLE_WRITES=1
